# Maintainer: Michael W. Olesen <michael.w.olesen@gmail.com>
# Kept in https://github.com/mwo-dk/bragd/tree/master/packaging/aur. In a clone, pkgver is the
# version of the clone's Cargo.toml, so `makepkg -si` here builds that release.
pkgname=bragd
pkgver=$(sed -n '/^version = /{s/^version = "\(.*\)"$/\1/p;q;}' "${startdir:-.}/../../../Cargo.toml")
pkgrel=1
pkgdesc='Play, study and keep board games: chess, go, shogi, xiangqi and more'
arch=('x86_64' 'aarch64')
url='https://github.com/mwo-dk/bragd'
license=('MIT')
depends=('webkit2gtk-4.1' 'gtk3' 'libsoup3' 'librsvg' 'gcc-libs' 'glibc')
makedepends=('cargo' 'npm')
optdepends=('podman: Engines from sealed container images')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
  (cd gui && npm ci --no-audit --no-fund)
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR="$PWD/target"
  (cd gui && npm run build)
  cargo build --frozen --release -p bragd-gui -p bragd-helper
}

check() {
  cd "$pkgname-$pkgver"
  RUSTUP_TOOLCHAIN=stable cargo test --frozen -p bragd-core
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/bragd-gui "$pkgdir/usr/bin/bragd-gui"
  install -Dm755 target/release/bragd-helper "$pkgdir/usr/bin/bragd-helper"
  install -Dm644 packaging/bsd/bragd.desktop "$pkgdir/usr/share/applications/bragd.desktop"
  install -Dm644 assets/brand/icons/128x128.png "$pkgdir/usr/share/icons/hicolor/128x128/apps/bragd.png"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
